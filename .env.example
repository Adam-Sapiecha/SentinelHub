# Full application: private workspaces, durable SQLite, user GeoJSON.
APP_MODE=application
COMPOSE_PROJECT_NAME=sentinelhub
DEMO_PORT=8090
IMAGE_TAG=local
DATA_DIR=data
WORKSPACE_DB_NAME=sentinelhub.sqlite3

# Optional operator-only REAL external imports. Never give these keys to visitors.
# Overpass requires ADMIN_API_KEY (random >=32 chars); no paid account is needed.
# Sentinel additionally requires an ACTIVE OGC instance with a configured FLOOD layer.
ADMIN_API_KEY=
SENTINELHUB_INSTANCE_ID=
SENTINELHUB_TIME_RANGE=

# Public HTTPS URL, including an optional path prefix. Funnel addresses are supported.
PUBLIC_URL=
PUBLIC_BASE_PATH=/
ALLOWED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090

# Legacy private single-dataset API only (not used by workspace application).
MAX_BBOX_AREA_KM2=2500
MAX_ROUTE_SNAP_DISTANCE_M=2000
MIN_FLOOD_OVERLAP_RATIO=0.01

# New public workspaces expire after this many hours. Existing v1 records stay persistent.
WORKSPACE_TTL_HOURS=24
